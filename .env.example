# Copy to .env and fill in. .env is gitignored and is never baked into the image.
# Load it before running locally:
#   bash:       set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }

# From BotFather.
BOT_TOKEN=123456:replace-me

# Any random string; must match the secret_token given to setWebhook.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-me

# Comma-separated Telegram user IDs. Ask each person to message @userinfobot.
ALLOWED_USER_IDS=111111111,222222222

# appsscript (default) or stub.
CODE_SOURCE=stub

# Stub knobs, ignored unless CODE_SOURCE=stub.
# ok | not_found | error | delayed
STUB_MODE=ok
STUB_LINK=https://example.invalid/login/confirm?token=stub
STUB_DELAY_SECONDS=1

# Required when CODE_SOURCE=appsscript.
# APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfy.../exec
# APPS_SCRIPT_SECRET=replace-me

# Cloud Run injects PORT; only set it locally if 8080 is taken.
# PORT=8080
